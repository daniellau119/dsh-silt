{
  "name": "dsh-silt",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Daniel Lau",
  "description": "Silt — cross-session memory, self-evolving persona and taste, drawn as a constellation.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
